# Copy this file to .env.local and fill in the values from
# Supabase dashboard > Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Stripe (Dashboard > Developers > API keys). Use test keys locally.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret of the webhook endpoint (whsec_...), from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
# Turn on after setting up Stripe Tax (origin address + registrations) in the dashboard.
STRIPE_AUTOMATIC_TAX=false
# "true" makes pricing buttons open Stripe Checkout. Keep "false" in production until launch.
NEXT_PUBLIC_CHECKOUT_ENABLED=false
# Lets the webhook write to the subscriptions table. Server only, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Emails via Resend (resend.com > API Keys). Without it, signups still work but no emails go out.
RESEND_API_KEY=re_...
# Sender. Keep the Resend test sender until your own domain is verified in Resend.
MAIL_FROM=QuietLead <onboarding@resend.dev>
# Where new-signup notifications go (also the reply-to address).
NOTIFY_EMAIL=you@example.com
